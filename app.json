
{
  "expo": {
    "name": "SafeRoute",
    "slug": "SafeRoute",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/saferoute-icon.png",
    "scheme": "saferoute",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saidanielk.SafeRoute",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07111F",
        "foregroundImage": "./assets/images/saferoute-icon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.saidanielk.SafeRoute"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-status-bar",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "SafeRouteQuickStart",
              "displayName": "SafeRoute Quick Start",
              "description": "Quickly open SafeRoute route planning.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SafeRouteQuickStart",
              "label": "SafeRoute Quick Start",
              "description": "Quickly open SafeRoute route planning.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 0
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba721f66-1801-4bd3-970c-778f30b4c291"
      }
    }
  }
}
